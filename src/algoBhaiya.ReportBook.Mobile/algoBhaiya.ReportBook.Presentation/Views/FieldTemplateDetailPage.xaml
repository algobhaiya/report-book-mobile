<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="algoBhaiya.ReportBook.Presentation.Views.FieldTemplateDetailPage"
             BackgroundColor="#80000000"
             Padding="18"
             Title="{Binding PageTitle}">

    <Grid VerticalOptions="Center"
          HorizontalOptions="Center"
          Padding="24,0,24,0">
        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F2937}"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="20"
                WidthRequest="360"
                MaximumWidthRequest="430"
                HeightRequest="460"
                MaximumHeightRequest="540">
            <ScrollView>
                <VerticalStackLayout Spacing="7">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding PageTitle}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}" />
                        <Label Text="{Binding PageSubtitle}"
                               FontSize="13"
                               FontAttributes="Italic"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A9B5}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Field name"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#2A3038}"
                                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#3E4652}"
                                Padding="14,7">
                            <Entry Placeholder="e.g. Study Time"
                                   Text="{Binding FieldName, Mode=TwoWay}"
                                   FontSize="16"
                                   BackgroundColor="Transparent"
                                   ClearButtonVisibility="WhileEditing"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                   PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#8A93A1}" />
                        </Border>
                        <Label Text="{Binding FieldNameError}"
                               IsVisible="{Binding HasFieldNameError}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Unit"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#2A3038}"
                                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#3E4652}"
                                Padding="6,2">
                            <Picker Title="Choose a unit"
                                    ItemsSource="{Binding DisplayUnitNames}"
                                    SelectedItem="{Binding SelectedUnitName}"
                                    FontSize="16"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#111827, Dark=White}" />
                        </Border>
                        <Label Text="{Binding SelectedUnitError}"
                               IsVisible="{Binding HasSelectedUnitError}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="5">
                        <Label Text="Display order"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#2A3038}"
                                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#3E4652}"
                                Padding="14,7">
                            <Entry Placeholder="e.g. 1"
                                   Text="{Binding FieldOrder, Mode=TwoWay}"
                                   Keyboard="Numeric"
                                   FontSize="16"
                                   BackgroundColor="Transparent"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                   PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#8A93A1}" />
                        </Border>
                        <Label Text="Lower numbers appear earlier in the form."
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A9B5}" />
                        <Label Text="{Binding FieldOrderError}"
                               IsVisible="{Binding HasFieldOrderError}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12"
                          Margin="0,6,0,0">
                        <Button Text="Cancel"
                                Clicked="OnCancelClicked"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#334155}"
                                TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                CornerRadius="16"
                                Padding="18,14" />

                        <Button Grid.Column="1"
                                Text="{Binding SubmitButtonText}"
                                Command="{Binding SubmitCommand}"
                                BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}"
                                TextColor="White"
                                CornerRadius="16"
                                Padding="22,14" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
