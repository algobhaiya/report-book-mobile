<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="algoBhaiya.ReportBook.Presentation.Views.StartupStreakLossPopup"
             BackgroundColor="#80000000"
             Padding="18">
    <Grid VerticalOptions="Center"
          HorizontalOptions="Center">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackdropTapped" />
        </Grid.GestureRecognizers>

        <Border x:Name="CardBorder"
                BackgroundColor="{AppThemeBinding Light=#F8FBFF, Dark=#0F2234}"
                Stroke="{AppThemeBinding Light=#D7E3F1, Dark=#27405A}"
                StrokeThickness="1"
                Padding="22"
                WidthRequest="330"
                MaximumWidthRequest="380"
                StrokeShape="RoundRectangle 28">
            <Border.Shadow>
                <Shadow Brush="#22000000"
                        Offset="0,-8"
                        Radius="18"
                        Opacity="0.25" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="18">
                <Grid HorizontalOptions="Center">
                    <Border WidthRequest="66"
                            HeightRequest="66"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=#D7E8FA, Dark=#24435F}"
                            StrokeShape="Ellipse">
                        <Label Text="⚡"
                               FontSize="26"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light=#2563EB, Dark=#5AA0E6}" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Streak"
                           FontSize="22"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="Center"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                    <Label Text="Fill the missed days."
                           FontSize="15"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#475569, Dark=#C1D2E2}" />
                    <Label Text="Get your streak back!"
                           FontSize="15"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#475569, Dark=#C1D2E2}" />
                </VerticalStackLayout>

                <Button Text="Got it"
                        Clicked="OnDismissClicked"
                        BackgroundColor="{AppThemeBinding Light=#1D4ED8, Dark=#2F66C7}"
                        TextColor="White"
                        CornerRadius="18"
                        HeightRequest="48" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
