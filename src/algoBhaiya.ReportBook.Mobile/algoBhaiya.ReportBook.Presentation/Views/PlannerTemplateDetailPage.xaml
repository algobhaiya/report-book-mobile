<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:algoBhaiya.ReportBook.Presentation.Views"
             x:Class="algoBhaiya.ReportBook.Presentation.Views.PlannerTemplateDetailPage"
             Title="Plan"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#173047}"
                StrokeThickness="0"
                Padding="15,17,15,15">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Button Text="&#x2190;"
                        FontSize="35"
                        FontAttributes="Bold"
                        VerticalOptions="Center"
                        BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#10212F}"
                        TextColor="{AppThemeBinding Light=#0F172A, Dark=#F4F7FB}"
                        CornerRadius="14"
                        WidthRequest="46"
                        HeightRequest="46"
                        Padding="0,-5,0,5"
                        Command="{Binding BackCommand}" />

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Planner"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F4F7FB}" />
                    <Label Text="{Binding Category}"
                           FontSize="13"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#AFC0D0}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,18,20,22" Spacing="16">
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{Binding AccentHex}">
                    <Grid Padding="16" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="48"
                                HeightRequest="48"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 999"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#10212F}"
                                VerticalOptions="Center">
                            <Label Text="{Binding FieldCountText}"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   LineBreakMode="WordWrap"
                                   MaxLines="2" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="8"
                                             VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   LineBreakMode="NoWrap" />
                            <Label Text="{Binding Summary}"
                                   FontSize="13"
                                   TextColor="#EEF4FA"
                                   LineBreakMode="WordWrap" />
                            <Label Text="{Binding IsBlankText}"
                                   IsVisible="{Binding IsBlank}"
                                   FontSize="12"
                                   TextColor="#D5E3F1"
                                   LineBreakMode="WordWrap" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Label Text="{Binding Description}"
                       FontSize="15"
                       LineHeight="1.4"
                       TextColor="{AppThemeBinding Light=#334155, Dark=#E2E8F1}" />

                <Border StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#243244}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#153348}"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Included items"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#2563EB, Dark=#8CC6FF}" />
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 999"
                                    BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#213A52}"
                                    Padding="10,5"
                                    VerticalOptions="Start">
                                <Label Text="{Binding FieldCountText}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#F4F7FB}" />
                            </Border>
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fields}"
                                             Spacing="10"
                                             IsVisible="{Binding HasFields}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="1"
                                            StrokeShape="RoundRectangle 16"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#243244}"
                                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#183142}"
                                            Padding="12,10">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border WidthRequest="36"
                                                    HeightRequest="36"
                                                    StrokeShape="RoundRectangle 14"
                                                    BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#213A52}"
                                                    StrokeThickness="0">
                                                <Label Text="{Binding FieldOrder}"
                                                       FontSize="13"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#1D4ED8, Dark=White}"
                                                       HorizontalTextAlignment="Center"
                                                       VerticalTextAlignment="Center" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="1"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding FieldName}"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F4F7FB}"
                                                       LineBreakMode="TailTruncation" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="2"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 999"
                                                    BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#10212F}"
                                                    Padding="8,4"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Unit.UnitName}"
                                                       FontSize="11"
                                                       TextColor="{AppThemeBinding Light=#2563EB, Dark=#8CC6FF}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <Border IsVisible="{Binding HasNoFields}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#183142}"
                                Padding="12">
                            <Label Text="{Binding FieldsEmptyText}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light=#475569, Dark=#D8E8F7}"
                                   LineBreakMode="WordWrap" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding IsBlank}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#153348}"
                        Padding="14">
                    <Label Text="This is an empty template. Start it to reach the daily entry page and add fields manually later."
                           FontSize="14"
                           TextColor="{AppThemeBinding Light=#475569, Dark=#D8E8F7}"
                           LineBreakMode="WordWrap" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="2"
                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}"
                StrokeThickness="0"
                Padding="20,12,20,20">
            <Button Text="Start Now"
                    Command="{Binding StartCommand}"
                    BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#5DA7E8}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="24"
                    Padding="18,16" />
        </Border>

        <Border IsVisible="{Binding IsLoading}"
                Grid.RowSpan="3"
                BackgroundColor="{AppThemeBinding Light=#66FFFFFF, Dark=#80000000}"
                StrokeThickness="0">
            <Border StrokeShape="RoundRectangle 22"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#243244}"
                    Padding="24"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                <VerticalStackLayout HorizontalOptions="Center"
                                     VerticalOptions="Center"
                                     Spacing="12">
                    <ActivityIndicator IsRunning="True"
                                       Color="{AppThemeBinding Light=#2563EB, Dark=#5DA7E8}"
                                       WidthRequest="42"
                                       HeightRequest="42" />
                    <Label Text="Starting your plan..."
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </Border>
    </Grid>
</ContentPage>
