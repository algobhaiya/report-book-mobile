<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:algoBhaiya.ReportBook.Presentation.Views"
             x:Class="algoBhaiya.ReportBook.Presentation.Views.FieldTemplatePage"
             Title="Items">

    <Grid Padding="10,10,5,0">
        <CollectionView ItemsSource="{Binding Templates}"
                        SelectionMode="None"
                        Margin="0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10"
                          Margin="0,0,0,12">
                        <Border Stroke="#E5E7EB"
                                StrokeThickness="1"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                                StrokeShape="RoundRectangle 18"
                                Padding="14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:FieldTemplatePage}}, Path=OpenDetailsCommand}"
                                                       CommandParameter="{Binding}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="*,Auto"
                                    ColumnSpacing="12">

                                <VerticalStackLayout Spacing="2">

                                    <Label Text="{Binding FieldName}"
                                       FontSize="16"
                                       FontAttributes="Bold"/>

                                    <Label Text="{Binding Unit.UnitName}"
                                       FontSize="14"
                                       FontAttributes="Italic"
                                       TextColor="DarkSlateGray"/>

                                    <Label Text="{Binding FieldOrder, StringFormat='Position: {0}'}"
                                       FontSize="12"
                                       TextColor="Gray"/>

                                </VerticalStackLayout>

                                <Switch Grid.Column="1"
                                    VerticalOptions="Center"
                                    IsToggled="{Binding IsEnabled, Mode=OneWay}"
                                    Toggled="OnSwitchToggled"/>

                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                WidthRequest="34"
                                HeightRequest="34"
                                StrokeShape="RoundRectangle 17"
                                BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#3A2225}"
                                Stroke="{AppThemeBinding Light=#FECACA, Dark=#7F1D1D}"
                                StrokeThickness="1"
                                VerticalOptions="Center"
                                HorizontalOptions="End">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type local:FieldTemplatePage}}, Path=DeleteCommand}"
                                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Label Text="&#x2212;"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <Border Stroke="#E5E7EB"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                        Padding="24"
                        Margin="0,24,0,0"
                        HorizontalOptions="Fill"
                        VerticalOptions="Center">
                    <VerticalStackLayout Spacing="12"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="No items yet"
                               FontSize="18"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Add your first item to start building the daily form."
                               TextColor="Gray"
                               FontSize="13"
                               HorizontalTextAlignment="Center" />
                        <Button Text="Add item"
                                Clicked="OnAddClicked"
                                HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.EmptyView>
        </CollectionView>

        <ImageButton Source="fab_add.svg"
                     Clicked="OnAddClicked"
                     Style="{StaticResource FloatingActionButtonStyle}"
                     HorizontalOptions="End"
                     VerticalOptions="End"
                     Margin="0,0,16,24" />
    </Grid>
</ContentPage>
