<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="algoBhaiya.ReportBook.Presentation.Views.UserDeleteChoicePopup"
             BackgroundColor="#80000000"
             Padding="18">
    <Grid VerticalOptions="Center"
          HorizontalOptions="Center">
        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnBackdropTapped" />
        </Grid.GestureRecognizers>

        <Border x:Name="CardBorder"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                Stroke="{AppThemeBinding Light=#D9E2EC, Dark=#334155}"
                StrokeThickness="1"
                Padding="22"
                WidthRequest="340"
                MaximumWidthRequest="390"
                StrokeShape="RoundRectangle 28">
            <Border.Shadow>
                <Shadow Brush="#22000000"
                        Offset="0,10"
                        Radius="22"
                        Opacity="0.28" />
            </Border.Shadow>

            <VerticalStackLayout Spacing="16">
                <Label Text="Remove profile?"
                       FontSize="22"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                <Label Text="{Binding PromptText}"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />

                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#172033}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2B3646}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="0">
                    <VerticalStackLayout Spacing="0">
                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#101A27}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 18,18,0,0"
                                Padding="16">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="38"
                                        HeightRequest="38"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#244266}"
                                        StrokeShape="Ellipse"
                                        VerticalOptions="Center">
                                    <Label Text="H"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#2563EB, Dark=#93C5FD}" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Hide profile"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                                    <Label Text="Keep the data on this device and show it again later."
                                           FontSize="12"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#AAB7C7}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text=">"
                                       FontSize="22"
                                       TextColor="{AppThemeBinding Light=#94A3B8, Dark=#7C8A9B}"
                                       VerticalOptions="Center" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnSoftDeleteClicked" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light=#E2E8F0, Dark=#2B3646}" />

                        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#101A27}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 0,0,18,18"
                                Padding="16">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="38"
                                        HeightRequest="38"
                                        StrokeThickness="0"
                                        BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#3A1F25}"
                                        StrokeShape="Ellipse"
                                        VerticalOptions="Center">
                                    <Label Text="!"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           HorizontalTextAlignment="Center"
                                           VerticalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="2">
                                    <Label Text="Delete permanently"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light=#B91C1C, Dark=#FCA5A5}" />
                                    <Label Text="Remove the profile and all related data from this device."
                                           FontSize="12"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light=#64748B, Dark=#AAB7C7}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text=">"
                                       FontSize="22"
                                       TextColor="{AppThemeBinding Light=#D16A62, Dark=#FCA5A5}"
                                       VerticalOptions="Center" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnHardDeleteClicked" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Cancel"
                        Clicked="OnCancelClicked"
                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#243041}"
                        TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                        CornerRadius="16"
                        HeightRequest="46" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
