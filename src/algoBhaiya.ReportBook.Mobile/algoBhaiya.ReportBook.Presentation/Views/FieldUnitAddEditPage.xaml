<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="algoBhaiya.ReportBook.Presentation.Views.FieldUnitAddEditPage"
             BackgroundColor="#80000000"
             Padding="20"
             Title="{Binding PageTitle}">

    <Grid VerticalOptions="Center"
          HorizontalOptions="Center"
          Padding="30,0,30,0">
        <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F2937}"
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#374151}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 24"
                Padding="20"
                WidthRequest="340"
                MaximumWidthRequest="420"
                HeightRequest="420"
                MaximumHeightRequest="500">
            <ScrollView>
                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="{Binding PageTitle}"
                               FontSize="22"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}" />
                        <Label Text="{Binding PageSubtitle}"
                               FontSize="13"
                               FontAttributes="Italic"
                               TextColor="{AppThemeBinding Light=#6B7280, Dark=#A1A9B5}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Unit name"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#2A3038}"
                                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#3E4652}"
                                Padding="14,10">
                            <Entry Placeholder="e.g. Hours, Pages, Minutes"
                                   Text="{Binding UnitName, Mode=TwoWay}"
                                   FontSize="16"
                                   BackgroundColor="Transparent"
                                   ClearButtonVisibility="WhileEditing"
                                   TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                   PlaceholderColor="{AppThemeBinding Light=#9CA3AF, Dark=#8A93A1}" />
                        </Border>
                        <Label Text="{Binding UnitNameError}"
                               IsVisible="{Binding HasUnitNameError}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Value type"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}" />
                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="{AppThemeBinding Light=#F9FAFB, Dark=#2A3038}"
                                Stroke="{AppThemeBinding Light=#D1D5DB, Dark=#3E4652}"
                                Padding="6,2">
                            <Picker Title="Select a type"
                                    ItemsSource="{Binding DisplayTypes}"
                                    SelectedItem="{Binding SelectedDisplayType}"
                                    FontSize="16"
                                    BackgroundColor="Transparent"
                                    TextColor="{AppThemeBinding Light=#111827, Dark=White}" />
                        </Border>
                        <Label Text="{Binding DisplayTypeError}"
                               IsVisible="{Binding HasDisplayTypeError}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="12"
                          Margin="0,5,0,0">
                        <Button Text="Cancel"
                                Clicked="OnCancelClicked"
                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#334155}"
                                TextColor="{AppThemeBinding Light=#111827, Dark=White}"
                                CornerRadius="16"
                                Padding="18,14" />

                        <Button Grid.Column="1"
                                Text="{Binding SubmitButtonText}"
                                Command="{Binding SubmitCommand}"
                                BackgroundColor="{AppThemeBinding Light=#2563EB, Dark=#3B82F6}"
                                TextColor="White"
                                CornerRadius="16"
                                Padding="22,14" />
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
