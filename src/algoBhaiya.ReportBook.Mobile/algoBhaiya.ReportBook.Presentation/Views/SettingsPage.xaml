<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="algoBhaiya.ReportBook.Presentation.Views.SettingsPage"
             Title="Settings"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <ScrollView>
        <VerticalStackLayout Padding="16,18" Spacing="14">

            <VerticalStackLayout Spacing="4">
                <Label Text="Settings"
                       FontSize="24"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                <Label Text="Tune edit lock and local retention for your daily reports."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
            </VerticalStackLayout>

            <Border StrokeShape="RoundRectangle 18"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#243244}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Daily report edit lock"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                        <Label Text="Choose how long entries stay editable before they become view-only."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10"
                          VerticalOptions="Center">
                        <Picker Title="Select duration (in days)"
                                ItemsSource="{Binding ModificationDurationOptions}"
                                SelectedItem="{Binding SelectedModificationDuration}"
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="Center" />
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="4"
                                               VerticalOptions="Center">
                            <Label Text="Days"
                                   VerticalOptions="Center"
                                   FontSize="13"
                                   FontAttributes="Italic"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Button Text="ⓘ"
                                    FontSize="18"
                                    BackgroundColor="Transparent"
                                    TextColor="#2563EB"
                                    Padding="0"
                                    HeightRequest="30"
                                    WidthRequest="30"
                                    CornerRadius="15"
                                    SemanticProperties.Description="More details"
                                    Clicked="OnModificationDurationInfoTapped" />
                        </HorizontalStackLayout>
                    </Grid>

                    <Label Text="Example: if set to 7 days, a form can still be edited during that window and then becomes locked."
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                </VerticalStackLayout>
            </Border>

            <Border StrokeShape="RoundRectangle 18"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#243244}"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}"
                    Padding="16">
                <VerticalStackLayout Spacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Data retention"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                        <Label Text="Set how many months of local data should stay on the device."
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="10"
                          VerticalOptions="Center">
                        <Picker Title="Select period (in months)"
                                ItemsSource="{Binding DataRemovalPeriodOptions}"
                                SelectedItem="{Binding SelectedDataRemovalPeriod}"
                                HorizontalOptions="FillAndExpand"
                                HorizontalTextAlignment="Center" />
                        <HorizontalStackLayout Grid.Column="1"
                                               Spacing="4"
                                               VerticalOptions="Center">
                            <Label Text="Months"
                                   VerticalOptions="Center"
                                   FontSize="13"
                                   FontAttributes="Italic"
                                   TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                            <Button Text="ⓘ"
                                    FontSize="18"
                                    BackgroundColor="Transparent"
                                    TextColor="#2563EB"
                                    Padding="0"
                                    HeightRequest="30"
                                    WidthRequest="30"
                                    CornerRadius="15"
                                    SemanticProperties.Description="More details"
                                    Clicked="OnDataRemovalPeriodInfoTapped" />
                        </HorizontalStackLayout>
                    </Grid>

                    <Label Text="Older data is cleaned up gradually, so this setting controls how far back the app keeps information locally."
                           FontSize="12"
                           LineBreakMode="WordWrap"
                           TextColor="{AppThemeBinding Light=#64748B, Dark=#94A3B8}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Save Settings"
                    Command="{Binding SaveSettingsCommand}"
                    BackgroundColor="#16A34A"
                    TextColor="White"
                    CornerRadius="14"
                    HeightRequest="52"
                    FontAttributes="Bold"
                    Margin="0,6,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
