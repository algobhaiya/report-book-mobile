<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:helpers="clr-namespace:algoBhaiya.ReportBook.Presentation.Helpers"
             xmlns:vm="clr-namespace:algoBhaiya.ReportBook.Presentation.ViewModels"
             x:Class="algoBhaiya.ReportBook.Presentation.Views.DailyEntryPage"
             x:DataType="vm:DailyEntryViewModel"
             Title="Daily"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <helpers:ValueTypeToVisibilityConverter x:Key="ValueTypeToVisibilityConverter" />
            <helpers:BoolStringConverter x:Key="BoolStringConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Fields}"
                        SelectionMode="None"
                        BackgroundColor="Transparent"
                        ItemSizingStrategy="MeasureFirstItem">
            <CollectionView.Header>
                <VerticalStackLayout Padding="20" Spacing="15">
                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#1F2937}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 18"
                            Padding="10,8">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="10"
                              VerticalOptions="Center">
                            <Button Text="&#x276E;"
                                    Clicked="OnPreviousDayClicked"
                                    BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1F2937}"
                                    TextColor="{AppThemeBinding Light=#1F2937, Dark=#F9FAFB}"
                                    CornerRadius="16"
                                    Padding="12,8"
                                    WidthRequest="48"
                                    HeightRequest="44"
                                    FontAttributes="Bold" />

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="2"
                                                 HorizontalOptions="Center"
                                                 VerticalOptions="Center">
                                <Label Text="Fill up"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#BFDBFE}" />

                                <Label Text="{Binding FormDate, StringFormat='{0:dd MMMM, yyyy}'}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F9FAFB}" />
                            </VerticalStackLayout>

                            <Button Grid.Column="2"
                                    Text="&#x276F;"
                                    Clicked="OnNextDayClicked"
                                    BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#1F2937}"
                                    TextColor="{AppThemeBinding Light=#1F2937, Dark=#F9FAFB}"
                                    CornerRadius="16"
                                    Padding="12,8"
                                    WidthRequest="48"
                                    HeightRequest="44"
                                    FontAttributes="Bold" />
                        </Grid>
                    </Border>

                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:DailyEntryFieldViewModel">
                    <Grid ColumnSpacing="12" Padding="2,4,4,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <Label Grid.Column="0"
                               Text="{Binding FieldTemplate.FieldName}"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               Margin="20,0,0,0"
                               MaxLines="2"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F9FAFB}" />

                        <Grid Grid.Column="1" VerticalOptions="Center">
                            <Entry Placeholder="Enter value"
                                   Keyboard="Numeric"
                                   HorizontalTextAlignment="Center"
                                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F9FAFB}"
                                   PlaceholderColor="{AppThemeBinding Light=#94A3B8, Dark=#6B7280}"
                                   Text="{Binding Value, Mode=TwoWay}"
                                   IsVisible="{Binding FieldTemplate.Unit.ValueType, Converter={StaticResource ValueTypeToVisibilityConverter}, ConverterParameter=numeric}" />

                            <CheckBox IsChecked="{Binding Value, Mode=TwoWay, Converter={StaticResource BoolStringConverter}}"
                                      IsVisible="{Binding FieldTemplate.Unit.ValueType, Converter={StaticResource ValueTypeToVisibilityConverter}, ConverterParameter=bool}" />
                        </Grid>

                        <Label Grid.Column="2"
                               Text="{Binding FieldTemplate.Unit.UnitName}"
                               IsVisible="{Binding FieldTemplate.Unit.ValueType, Converter={StaticResource ValueTypeToVisibilityConverter}, ConverterParameter=numeric}"
                               FontAttributes="Italic"
                               TextColor="{AppThemeBinding Light=#64748B, Dark=#9CA3AF}"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Start" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Border Grid.Row="1"
                Padding="20,0,20,7"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#0F172A}"
                StrokeThickness="0"
                IsVisible="True">
            <VerticalStackLayout Spacing="8">
                <Label Text="This entry is locked and can't be edited."
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light=#DC2626, Dark=#FCA5A5}"
                       FontAttributes="Italic"
                       FontSize="12"
                       IsVisible="{Binding IsReadOnly}" />

                <Button Text="Submit Entry"
                        Command="{Binding SubmitCommand}"
                        IsVisible="{Binding CanShowSubmit}"
                        BackgroundColor="{AppThemeBinding Light=#16A34A, Dark=#22C55E}"
                        TextColor="White">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Property="Opacity" Value="0.45" />
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#94A3B8, Dark=#334155}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>
                </Button>
            </VerticalStackLayout>
        </Border>

        <Grid Grid.RowSpan="2"
              IsVisible="{Binding IsLoading}"
              BackgroundColor="{AppThemeBinding Light=#66000000, Dark=#99000000}"
              InputTransparent="False">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="{AppThemeBinding Light=White, Dark=#F9FAFB}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

        <Grid Grid.RowSpan="2"
              IsVisible="{Binding ShowCompletionCelebration}"
              BackgroundColor="#AA0F172A"
              HorizontalOptions="Fill"
              VerticalOptions="Fill"
              InputTransparent="True">
            <Border HorizontalOptions="Center"
                    VerticalOptions="Center"
                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                    Stroke="{AppThemeBinding Light=#A5D6A7, Dark=#374151}"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 28"
                    Padding="15,17,15,17"
                    Margin="0"
                    WidthRequest="270">
                <Grid RowDefinitions="Auto,*"
                      RowSpacing="12"
                      HorizontalOptions="Center"
                      VerticalOptions="Center">
                    <Border Grid.Row="0"
                            WidthRequest="56"
                            HeightRequest="56"
                            HorizontalOptions="Center"
                            VerticalOptions="Start"
                            BackgroundColor="{AppThemeBinding Light=#E8F5E9, Dark=#1F2937}"
                            Stroke="{AppThemeBinding Light=#A5D6A7, Dark=#374151}"
                            StrokeThickness="2"
                            StrokeShape="RoundRectangle 999">
                        <Label Text="🎯"
                               FontSize="28"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
                    </Border>

                    <VerticalStackLayout Grid.Row="1"
                                         Spacing="10"
                                         HorizontalOptions="Center"
                                         VerticalOptions="Center">
                        <Label Text="Alhamdulillah, all done."
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#1B5E20, Dark=#F9FAFB}" />

                        <Label Text="You completed all items for this day."
                               FontSize="12"
                               HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light=#4B5563, Dark=#D1D5DB}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
