<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:algoBhaiya.ReportBook.Presentation.Views"
             x:Class="algoBhaiya.ReportBook.Presentation.Views.FieldUnitPage"
             Title="Units">

    <Grid Padding="5,5,5,0">
        <CollectionView ItemsSource="{Binding Units}"
                        SelectionMode="None"
                        Margin="0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BorderColor="#E0E0E0"
                           CornerRadius="12"
                           Padding="15"
                           Margin="0,5"
                           HasShadow="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <VerticalStackLayout>
                                <Label Text="{Binding UnitName}"
                                       FontAttributes="Bold"
                                       FontSize="16" />
                                <Label Text="{Binding ValueType}"
                                       FontSize="13"
                                       TextColor="Gray" />
                            </VerticalStackLayout>

                            <Button Text="✏"
                                    FontSize="14"
                                    Padding="6"
                                    CornerRadius="6"
                                    BackgroundColor="#EEEEEE"
                                    Grid.Column="1"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Margin="5,0,0,0">
                                <Button.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:FieldUnitPage}}, Path=OpenDetailsCommand}"
                                        CommandParameter="{Binding .}" />
                                </Button.GestureRecognizers>
                            </Button>

                            <Button Text="🗑"
                                    FontSize="14"
                                    Padding="6"
                                    CornerRadius="6"
                                    BackgroundColor="#FFCDD2"
                                    TextColor="DarkRed"
                                    Grid.Column="2"
                                    VerticalOptions="Center"
                                    HorizontalOptions="End"
                                    Margin="5,0,0,0">
                                <Button.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type local:FieldUnitPage}}, Path=DeleteCommand}"
                                        CommandParameter="{Binding .}" />
                                </Button.GestureRecognizers>
                            </Button>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <StackLayout Padding="20"
                             HorizontalOptions="Center"
                             VerticalOptions="Center">
                    <Label Text="No units found."
                           TextColor="Gray"
                           FontAttributes="Italic"
                           FontSize="15" />
                </StackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <ImageButton Source="fab_add.svg"
                     Clicked="OnAddClicked"
                     Style="{StaticResource FloatingActionButtonStyle}"
                     HorizontalOptions="End"
                     VerticalOptions="End"
                     Margin="0,0,16,24" />
    </Grid>
</ContentPage>
